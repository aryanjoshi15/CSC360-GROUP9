<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.MainController"
            styleClass="root">

    <top>
        <VBox spacing="5" styleClass="header">
            <Label text="Dashboard" styleClass="heading"/>
            <Label text="Swing and JavaFX working together" styleClass="subtitle"/>
        </VBox>
    </top>

    <center>
        <VBox spacing="15">

            <HBox spacing="15" styleClass="cards">
                <VBox styleClass="card">
                    <Label text="Users" styleClass="card-title"/>
                    <Label text="1,284" styleClass="card-value"/>
                </VBox>

                <VBox styleClass="card">
                    <Label text="Projects" styleClass="card-title"/>
                    <Label text="42" styleClass="card-value"/>
                </VBox>

                <VBox styleClass="card">
                    <Label text="Tasks" styleClass="card-title"/>
                    <Label text="187" styleClass="card-value"/>
                </VBox>

                <VBox styleClass="card">
                    <Label text="Active" styleClass="card-title"/>
                    <Label text="96%" styleClass="card-value"/>
                </VBox>
            </HBox>

            <Label text="Recent Users" styleClass="section-title"/>

            <HBox spacing="10" alignment="CENTER_LEFT">
                <TextField fx:id="searchField"
                           promptText="Search users..."
                           HBox.hgrow="ALWAYS"/>

                <ComboBox fx:id="filterBox" prefWidth="120"/>

                <Button text="Search"
                        onAction="#handleSearch"
                        styleClass="primary-button"/>
            </HBox>

            <TableView fx:id="userTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="nameColumn" text="Name" prefWidth="200"/>
                    <TableColumn fx:id="emailColumn" text="Email" prefWidth="300"/>
                    <TableColumn fx:id="statusColumn" text="Status" prefWidth="150"/>
                </columns>
            </TableView>

            <HBox spacing="10">
                <Button text="Add User"
                        onAction="#handleAddUser"
                        styleClass="primary-button"/>
                <Button text="Delete"
                        onAction="#handleDeleteUser"/>
                <Button text="Process"
                        onAction="#handleProcess"/>
            </HBox>

            <ProgressBar fx:id="progressBar"
                         progress="0"
                         maxWidth="Infinity"/>

            <Label fx:id="statusLabel"
                   text="Ready"
                   styleClass="fx-status"/>
        </VBox>
    </center>
</BorderPane>
